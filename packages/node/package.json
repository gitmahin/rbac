{
  "name": "@rbac-kit/node",
  "description": "Lightweight, type-safe RBAC for Node.js with pluggable in-memory and Redis storage.",
  "version": "1.2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsdown",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "homepage": "https://github.com/gitmahin/rbac/tree/main/packages/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitmahin/rbac.git"
  },
  "keywords": [
    "rbac",
    "role-based-access-control",
    "access-control",
    "authorization",
    "permissions",
    "roles",
    "acl",
    "redis",
    "in-memory",
    "storage",
    "typescript",
    "nodejs"
  ],
  "author": "Nimul Islam Mahin nimulmahin@gmail.com",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@rbac/constants": "workspace:*"
  },
  "devDependencies": {
    "@rbac/eslint-config": "workspace:*",
    "@rbac/typescript-config": "workspace:*"
  },
  "peerDependencies": {
    "redis": "^6.4.0"
  }
}
