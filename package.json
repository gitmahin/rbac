{
  "name": "rbac",
  "version": "1.4.2",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=30",
    "check:lint": "turbo run check:lint",
    "fix:lint": "turbo run fix:lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,css}\"",
    "check:types": "turbo run check:types",
    "gen:docs": "typedoc",
    "gen:docs-all": "npm run docs --workspaces --if-present",
    "clean": "turbo run clean && rm -rf node_modules dist .turbo && echo 'Root Cleanup complete!'",
    "commit": "cz",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/cz-commitlint": "^21.2.4",
    "@commitlint/prompt-cli": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@rbac/types": "workspace:*",
    "prettier": "^3.6.2",
    "@types/node": "^26.6.6",
    "commitizen": "^4.3.2",
    "commitlint-plugin-tense": "^1.0.12",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "husky": "^9.1.7",
    "inquirer": "^14.3.1",
    "tsdown": "^0.23.7",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  }
}
